# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# Publishable key is safe to expose to the browser (NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret key — server-side only, never prefix with NEXT_PUBLIC_
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret — obtained from the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Sanity CMS ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# API token — server-side only, never prefix with NEXT_PUBLIC_
SANITY_API_TOKEN=your-sanity-api-token

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
